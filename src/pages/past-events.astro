---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allEvents = await getCollection('events');

const pastEvents = allEvents
  .filter((e) => e.data.status === 'past')
  .sort((a, b) => b.data.sortDate.localeCompare(a.data.sortDate));

const renderedPastEvents = await Promise.all(
  pastEvents.map(async (event) => ({
    event,
    Content: (await render(event)).Content,
  }))
);

function resolveUrl(url: string) {
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  return `${base}${url.startsWith('/') ? url : `/${url}`}`;
}
---

<Layout
  title="Past Events — Beacon Repair Cafe"
  description="Archive of past Beacon-Fishkill Repair Cafe community events, flyers, and press materials."
  activeNav="past-events"
>
  <section class="bg-surface-container-lowest py-12 border-b border-outline-variant/20">
    <div class="max-w-5xl mx-auto px-6 space-y-3">
      <p class="text-xs uppercase tracking-widest font-bold text-primary">Community Archive</p>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-secondary">
        PAST REPAIR CAFE EVENTS
      </h1>
      <p class="text-lg text-on-surface-variant max-w-2xl">
        A look back at our previous Beacon-Fishkill Repair Cafes, flyers, and community press materials.
      </p>
    </div>
  </section>

  <section class="py-12 bg-surface-warm">
    <div class="max-w-5xl mx-auto px-6 space-y-12">
      {renderedPastEvents.length === 0 ? (
        <div class="bg-surface-container-lowest p-8 rounded-lg border border-outline-variant/30 text-center text-on-surface-variant">
          No past events archived yet.
        </div>
      ) : (
        renderedPastEvents.map(({ event, Content }) => (
          <article class="bg-surface-container-lowest rounded-lg border border-outline-variant/30 overflow-hidden shadow-xs">
            <!-- Event Header Banner -->
            <div class="bg-surface-container p-6 sm:p-8 border-l-4 border-primary">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                  <span class="inline-block text-xs uppercase tracking-widest font-bold text-primary mb-1">
                    Archived Event
                  </span>
                  <h2 class="text-2xl font-bold text-on-surface">{event.data.title}</h2>
                </div>
                <div class="text-sm sm:text-right">
                  <div class="font-bold text-on-surface text-base">{event.data.date}</div>
                  <div class="text-on-surface-variant">{event.data.hours}</div>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-outline-variant/30 text-sm text-on-surface-variant">
                <span class="font-bold uppercase tracking-wider text-xs mr-2">Location:</span>
                <span class="font-semibold text-on-surface">{event.data.location}</span>
              </div>
            </div>

            <!-- Event Body & Assets -->
            <div class="p-6 sm:p-8 space-y-6">
              <p class="text-on-surface-variant text-lg leading-relaxed">{event.data.summary}</p>
              <div class="text-on-surface-variant leading-relaxed">
                <Content />
              </div>

              {event.data.assets && event.data.assets.length > 0 && (
                <div class="pt-4 border-t border-outline-variant/20 space-y-4">
                  <h3 class="text-sm uppercase tracking-widest font-bold text-secondary">
                    Event Flyers &amp; Materials
                  </h3>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    {event.data.assets.map((asset) => (
                      <div class="bg-surface-warm p-3 rounded-lg border border-outline-variant/30 space-y-3">
                        {asset.image && (
                          <div class="aspect-square bg-surface-dim overflow-hidden flex items-center justify-center rounded-sm">
                            <img
                              src={resolveUrl(asset.image)}
                              alt={asset.title}
                              class="w-full h-full object-cover"
                            />
                          </div>
                        )}
                        <div class="flex justify-between items-center gap-2">
                          <p class="text-sm font-bold text-on-surface">{asset.title}</p>
                          <a
                            href={resolveUrl(asset.url)}
                            download={asset.download ? '' : undefined}
                            target={asset.download ? undefined : '_blank'}
                            rel={asset.download ? undefined : 'noopener noreferrer'}
                            class="text-sm font-semibold text-secondary hover:text-primary transition-colors shrink-0"
                          >
                            {asset.actionLabel}
                          </a>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      )}

      <div class="pt-4">
        <a href={`${base}/`} class="text-primary font-semibold hover:underline">
          ← Back to Upcoming Event
        </a>
      </div>
    </div>
  </section>
</Layout>
